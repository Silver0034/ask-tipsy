---
// Imports & components
import Layout from '@layouts/LayoutPage.astro'
import HeadingCallouts from '@components/HeadingCallouts.astro'
import Hero from '@components/Hero.astro'
import RecipeCTARepeater from '@components/RecipeCTARepeater.astro'
import { getEntry } from 'astro:content'

const featuredRecipe = await getEntry('recipes', 'cosmopolitan')
if (!featuredRecipe) {
	throw new Error('No featured recipe found')
}

// Page title for SEO / Featured Image / Meta Tags
export const title = 'Find the perfect drink recipe for any occasion'

// Local constants
const tabTitle = 'Explore',
	description =
		'Cocktail recipes, mixology tips, & bar guides! AskTipsy helps you find, create, & master delicious drinks. Find the perfect recipe to responsibly enjoy today.',
	structuredDataType = 'Organization'
---

<Layout
	description={description}
	structuredDataType={structuredDataType}
	title={title}
	titleTab={tabTitle}
>
	<Hero
		description={featuredRecipe.data.description}
		image={featuredRecipe.data.image}
		imageAlt={featuredRecipe.data.imageAlt}
		subtitle='Ring in 2025!'
		title={featuredRecipe.data.title}
	>
		<RecipeCTARepeater
			slot='ctas'
			recipe={featuredRecipe}
			ctas={[['like', 'save', 'share'], ['visit']]}
		/>
	</Hero>

	<HeadingCallouts
		id='intro'
		heading="Hi, I'm Tipsy"
		text='What would you like to enjoy today?'
	/>
</Layout>
