---
// Imports & components
import { Icon } from 'astro-icon/components'
import Layout from '@layouts/LayoutPage.astro'
import HeadingCallouts from '@components/HeadingCallouts.astro'
import HeroFeaturedRecipe from '@components/HeroFeaturedRecipe.astro'
import { getEntry } from 'astro:content'

const featuredRecipe = await getEntry('recipes', 'cosmopolitan')

// Page title for SEO / Featured Image / Meta Tags
export const title = 'The Home Page from my Astro Template'

// Local constants
const tabTitle = 'Home Page',
	description =
		'This is a page description and it needs to be between 12 and 160 characters. This is a page description and it needs to be between 12 and 160 characters.',
	structuredDataType = 'Organization'

// Images
// import featuredImage from '@assets/homepage-featured-image.png'
---

<Layout
	description={description}
	structuredDataType={structuredDataType}
	title={title}
	tabTitle={tabTitle}
>
	<HeroFeaturedRecipe recipe={featuredRecipe} subtitle='Ring in 2025!' />

	<HeadingCallouts
		id='intro'
		heading="Hi, I'm Tipsy"
		text='What would you like to enjoy today?'
	/>
</Layout>

