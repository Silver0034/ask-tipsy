---
import GoogleFonts from './GoogleFonts.astro'
import '../styles/main.scss'
import { ViewTransitions } from 'astro:transitions'

const { title, description } = Astro.props

if (!title) {
	throw new Error('Head.astro: The title prop is required.')
}

const titleEnding = ' | ' + __SITE_NAME__

const formattedTitle = title + ' | ' + __SITE_NAME__

if (!formattedTitle || formattedTitle.length > 60) {
	throw new Error(
		`Head.astro: The title should be fewer than ${60 - titleEnding.length} characters for SEO purposes.`
	)
}

if (!description) {
	throw new Error('Head.astro: The description prop is required.')
}

if (description.length < 50) {
	throw new Error(
		'Head.astro: The description should be at least 50 characters for SEO purposes.'
	)
}

if (description.length > 160) {
	throw new Error(
		'Head.astro: The description should be fewer than 160 characters for SEO purposes.'
	)
}
---

<head>
	<meta charset='utf-8' />
	<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
	<meta name='viewport' content='width=device-width' />
	<meta name='generator' content={Astro.generator} />
	<GoogleFonts />
	<title>{formattedTitle}</title>
	<meta name='description' content={description} />
	<ViewTransitions />
</head>

<a href='#content' class='skip-link'> Skip to content </a>
