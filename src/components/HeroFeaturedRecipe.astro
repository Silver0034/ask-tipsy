---
import { getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'
import { Picture } from 'astro:assets'
import RecipeCTAs from '@components/RecipeCTAs.astro'
import type { CollectionEntry } from 'astro:content'

// images
import separator from '@assets/wavy-separator.svg?raw'

type HeroFeaturedRecipeProps = {
	subtitle?: string
	recipe: CollectionEntry<'recipes'>
	ctas?: string[][]
}

const {
	ctas = [['like', 'save', 'share'], ['visit']],
	recipe,
	subtitle
} = Astro.props as HeroFeaturedRecipeProps

const { data } = recipe
const { title, description, image, imageAlt } = data
---

<style lang='scss'>
	@use '@styles/fonts';
	@use '@styles/breakpoints' as *;

	#hero {
		position: relative;
		display: grid;
		grid-template-columns: subgrid;
		grid-column: 1 / -1;
		height: min-content;
		padding-block-end: 0;

		&::before {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			height: 100%;
			width: 100%;
			background: linear-gradient(
				to bottom,
				rgba(0, 0, 0, 0.5) 0%,
				rgba(0, 0, 0, 0.5) 100%
			);
			z-index: -1;
		}
	}
	.background {
		position: absolute;
		top: 0;
		left: 0;
		height: 100%;
		width: 100%;
		object-fit: cover;
		z-index: -2;
	}
	.content {
		grid-column: 2 / -2;
	}

	.subtitle {
		position: relative;
		display: inline-block;
		transform: rotate(-2deg);
		margin-block: 1em;
	}

	.highlight {
		--highlight-size: 1rem;
		--offset-x: 1rem;
		--offset-y: 0.45rem;
		position: absolute;
		height: auto;
		width: var(--highlight-size);

		&.bottom-left {
			left: 0;
			bottom: 0;
			transform: translateX(calc(var(--offset-x) * -1))
				translateY(var(--offset-y));
		}

		&.top-right {
			right: 0;
			right: 0;
			transform: translateX(var(--offset-x))
				translateY(calc(var(--offset-y) * -1));
		}
	}
	h1 {
		@include fonts.body(700);
	}
	.ctas {
		display: flex;
		justify-content: space-between;
		gap: 1em;
		margin-block-start: 1em;

		@include breakpoint('small') {
			flex-direction: column;
			gap: 0;
		}
	}

	.separator {
		grid-column: 1 / -1;
		transform: translateY(5px);
	}
</style>

<slot name='before-start' />
<section id='hero' class='featured-recipe dark'>
	<div class='content'>
		<slot name='start' />
		{
			subtitle && (
				<p class='subtitle h3' data-motion='up-right'>
					<Icon
						class='highlight bottom-left'
						name='highlight-bottom-left'
					/>
					{subtitle}
					<Icon
						class='highlight top-right'
						name='highlight-top-right'
					/>
				</p>
			)
		}
		<slot name='before-title' />
		<h1 data-motion='right'>
			{title}
		</h1>
		<slot name='after-title' />
		<slot name='before-description' />
		<p class='description' data-motion='right'>{description}</p>
		<slot name='before-description' />

		<div class='ctas'>
			<slot name='ctas-before-start' />
			{
				ctas &&
					ctas.map((cta) => (
						<RecipeCTAs recipe={recipe} ctas={cta}>
							<slot name='ctas-start' slot='start' />
							<slot name='ctas-end' slot='end' />
						</RecipeCTAs>
					))
			}
			<slot name='ctas-after-end' />
		</div>

		<slot name='end' />
	</div>
	<div class='separator'>
		<Fragment set:html={separator} />
	</div>
	<Picture class='background' src={image} alt={imageAlt} />
</section>
<slot name='after-end' />
