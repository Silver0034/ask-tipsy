{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@assets/*": ["src/assets/*"],
			"@components/*": ["src/components/*"],
			"@content/*": ["src/content/*"],
			"@layouts/*": ["src/layouts/*"],
			"@public/*": ["public/*"],
			"@styles/*": ["src/styles/*"]
		}
	}
}
