---
import { getCollection } from 'astro:content'
const { tag } = Astro.props
const allArticles = await getCollection('articles')
const filteredRecipes = tag
	? allArticles.filter((article) => article.data.tags.includes(tag))
	: allArticles

const skipLinkID = Math.random().toString(36).substring(2, 15)
---

<a href={`#${skipLinkID}`} class='skip-link'>Skip articles list.</a>
<ul class='article-snippets'>
	{
		filteredRecipes.map((article) => (
			<li>
				<h3>
					<a
						class='font-subheading'
						href={`/articles/${article.slug}/`}
					>
						{article.data.title}
					</a>
				</h3>
				<p>{article.data.description}</p>
			</li>
		))
	}
</ul>
<span id={skipLinkID}></span>

<style lang='scss'>
	h3 {
		font-size: var(--font-size--large);
	}
	a {
		text-decoration: none;
	}
	p {
		margin-top: 0;
	}
</style>
