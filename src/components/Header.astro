---
const words = SITE_NAME.split(/(?=[A-Z])|\s+/)
---

<style lang='scss'>
	@use '@styles/colors';

	header {
		position: sticky;
		display: grid;
		grid-template-columns: subgrid;
		top: 0;
		z-index: 1;
		width: 100%;
		height: var(--header-height);
		margin-block-end: calc(var(--header-height) * -1);
		color: colors.get('background');
		align-content: center;
	}
	.content {
		grid-column: 2 / -2;
	}
	.word {
		display: inline-block;
		margin-left: 0.25ch;

		line-height: 1.5em;

		span {
			display: inline-block;
			transform: rotate(1deg);
		}
	}
	.word:nth-child(even) span {
		transform: translateY(-0.15em) rotate(-4deg);
	}

	a {
		display: inline-block;
	}
</style>

<header>
	<div class='content'>
		<a
			class='h2'
			href='/'
			aria-label='Home'
			data-motion='down-right'
			data-motion-stagger='header .word'
		>
			{
				words.map((word) => (
					<span class='word drop-shadow'>
						<span>{word}</span>
					</span>
				))
			}
		</a>
	</div>
</header>
